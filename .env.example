# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Somente para uso em rotas de servidor que precisam ignorar RLS (ex.: jobs administrativos,
# webhooks das Fases 3/4). NUNCA exponha esta chave no cliente nem a use em Server Components
# que respondem a pedidos de usuários comuns.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional (recomendado antes de divulgar a landing em escala): rate limit
# real e compartilhado entre instâncias via Upstash Redis (upstash.com,
# plano gratuito serve). Usado hoje pela lista de espera
# (src/lib/rate-limit.ts); sem essas variáveis, cai num fallback em
# memória que só protege uma instância de servidor por vez.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
